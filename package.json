{
  "name": "magpie-zcode",
  "version": "0.1.2",
  "description": "magpie provider plugin: signs in to ZCode's GLM Coding Plan (Z.ai or BigModel / 智谱) the way ZCode does, including team seats and ZCode's free Start Plan, and claims its gift plans daily",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "bin": {
    "magpie-plugin": "./scripts/cli.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "README-TEMPLATE.md",
    "AGENTS.md",
    "CHECKLIST.md",
    "HOOKS.md",
    "UPDATING.md",
    "CHANGELOG.md",
    "MULTI-PROVIDER.md",
    "NOTICE.md",
    "LICENSE",
    "extract-contract.py",
    "registry-entry.json",
    "tests",
    "scripts",
    "examples",
    "ERROR-CODES.md",
    "RECYCLING.md",
    "GUIDE.md",
    "OFFICIAL-SOURCES.md",
    "SCORING.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "zcode",
    "z.ai",
    "bigmodel",
    "glm",
    "coding-plan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morning-start/magpie-zcode.git"
  },
  "bugs": {
    "url": "https://github.com/morning-start/magpie-zcode/issues"
  },
  "homepage": "https://github.com/morning-start/magpie-zcode#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 3,
    "maxAccounts": 2,
    "name": "智谱 ZCode"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:errors": "node scripts/check-error-codes.mjs .",
    "check:template": "node scripts/check.mjs --template",
    "check:ua": "node scripts/check-ua.mjs .",
    "create": "node scripts/create.mjs",
    "release": "node scripts/release.mjs",
    "score": "node scripts/score.mjs",
    "maintenance": "node scripts/check-maintenance.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  }
}
